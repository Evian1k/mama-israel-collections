# ============================================================================
# Frontend (Next.js) — copy to .env and fill in. NEVER commit the real .env.
# Never expose secrets through NEXT_PUBLIC_* (inlined into the browser bundle).
# ============================================================================

# --- Production / split deployment -------------------------------------------
# Base URL of the Fastify backend, e.g. https://mama-israel-api.onrender.com
# Leave EMPTY for same-origin local development (the proxy handles /api/*).
NEXT_PUBLIC_API_URL=

# Canonical site URL for SEO/OG metadata + sitemap/robots, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# --- Optional -----------------------------------------------------------------
# Default WhatsApp number in international digits (e.g. 254712345678).
# The owner normally configures this in Admin → Settings (stored in PostgreSQL).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# `true` re-enables the Phase 1 in-memory sample-data buttons. Keep unset/false.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=

# --- Sandbox / local same-origin development ----------------------------------
# Internal proxy target (e.g. http://127.0.0.1:3900). Next.js forwards /api/*
# and /uploads/* to the local backend so a single exposed port serves
# everything. NEVER set this on a split production deployment (e.g. Vercel).
BACKEND_API_URL=

# --- Dev adapter only (ignored by the production backend) ----------------------
# SQLite file for the Phase 1 offline dev adapter; Postgres is used in production.
DATABASE_URL=
# Credentials for the in-memory Phase 1 admin login. The production backend
# has its own bootstrap vars (backend/.env). Dev-only — randomised if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
