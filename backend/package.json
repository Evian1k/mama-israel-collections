{
  "name": "mama-israel-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production backend API for Mama Israel Collections — Fastify + Prisma + PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:api": "tsx tests/api-tests.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "17.10.0-beta.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": [
    "@embedded-postgres/linux-x64"
  ]
}
