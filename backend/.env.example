# ============================================================================
# Backend (Fastify API) — copy to backend/.env and fill in.
# NEVER commit the real .env. Never put these values in frontend code.
# ============================================================================

# --- Core ---------------------------------------------------------------------
# production | development. `production` enables strict config validation
# (refuses to boot insecurely) + generic 500 responses.
NODE_ENV=development

# API port (hosting platforms inject their own).
PORT=3900

# PostgreSQL connection string. The API refuses file: (SQLite) URLs and
# refuses to boot in production when missing.
# Local embedded instance: postgresql://postgres@127.0.0.1:54329/mama_israel
DATABASE_URL=

# Admin session signing secret — >= 32 random chars (e.g. `openssl rand -hex 48`).
JWT_SECRET=

# Access-token lifetime (default 7d).
JWT_EXPIRES_IN=7d

# Comma-separated allowlist of frontend origins for CORS,
# e.g. https://your-domain.com,https://your-app.vercel.app. Never use a bare *.
FRONTEND_URL=

# --- Admin bootstrap (used ONLY to create the account on first boot) -----------
# Passwords are bcrypt-hashed; the owner is forced to change the password at
# first login. Rotate in place with: bun run scripts/set-admin-password.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Owner

# --- Product image storage ------------------------------------------------------
# Leave all three empty to use the local-disk fallback (fine for self-hosting
# with persistent disk; ephemeral hosts MUST configure Cloudinary instead).
# CLOUDINARY_API_SECRET is server-side only — never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- M-Pesa ---------------------------------------------------------------------
# Manual Till/Paybill payments (the default) need NO credentials here — the
# owner enters her Till/Paybill in Admin → Settings → Payments.
# The values below are only for the optional future Daraja STK Push flow.
# live | simulator (simulator is a dev-only test mode and is REFUSED in production)
MPESA_MODE=live
# sandbox | production (switches the Daraja base URL)
MPESA_ENV=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS callback: https://<api-host>/api/payments/mpesa/callback
MPESA_CALLBACK_URL=

# --- Transactional email (Resend) ------------------------------------------------
# Without a key, order emails are recorded in the EmailLog audit table but not
# sent — clearly surfaced in Admin → Settings → Production readiness.
RESEND_API_KEY=
# From header, e.g. "Mama Israel Collections <orders@your-domain.com>"
EMAIL_FROM=
# Optional inbox for the admin new-order notification.
EMAIL_ADMIN_INBOX=
